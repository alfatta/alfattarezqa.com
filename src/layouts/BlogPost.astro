---
import SiteLayout from "./SiteLayout.astro";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import ContactBanner from "../components/ContactBanner.astro";
import { SITE_TITLE } from "../consts";
import { ABOUT } from "../data/profile";
type Props = CollectionEntry<"blog">["data"];
const { title, description, pubDate, updatedDate, heroImageUrl } = Astro.props;
---

<SiteLayout
  title={`${title} | ${SITE_TITLE}`}
  description={description}
  image={heroImageUrl}
  imageAlt={title}
  article={{ title, published: pubDate, modified: updatedDate }}
>
  <main id="main" class="site-width article-main">
    <a class="text-link back-link" href="/blog/">
      ← All notes
    </a>
    <article class="window">
      <div class="window-bar">
        <span>▤ &nbsp; from-the-keyboard.md</span>
        <span class="window-controls" aria-hidden="true">
          <span>−</span>
          <span>□</span>
          <span>×</span>
        </span>
      </div>
      <header class="article-header">
        <div class="article-date">
          <a href="/about/" rel="author">
            {ABOUT.name}
          </a>
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <span>
              {" "}
              / Updated <FormattedDate date={updatedDate} />
            </span>
          )}
        </div>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
    <ContactBanner />
  </main>
</SiteLayout>

<style>
  .article-main {
    max-width: 850px;
    padding-top: 36px;
  }
  .article-header {
    border-bottom: 1px solid var(--line);
    padding: 36px;
  }
  .article-header h1 {
    font-size: clamp(46px, 6.5vw, 72px);
    margin: 20px 0;
  }
  .article-header p {
    color: var(--muted);
    font-size: 13px;
  }
  .article-date {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 10px;
    color: var(--muted);
  }
  .prose {
    padding: 36px;
    font-size: 14px;
    line-height: 1.95;
    overflow-wrap: anywhere;
  }
  .prose :global(p) {
    margin-bottom: 24px;
  }
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--font-mono);
    font-size: 21px;
    line-height: 1.4;
    margin: 36px 0 18px;
  }
  .prose :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    margin: 15px 0 30px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 20px 0;
    padding-left: 25px;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    background: var(--blue);
    padding: 2px 4px;
    font-size: 0.9em;
  }
  .prose :global(pre) {
    padding: 20px;
    overflow-x: auto;
    border: 1px solid var(--line);
    margin: 25px 0;
  }
  .prose :global(pre code) {
    padding: 0;
    background: transparent;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 5px 20px;
    margin: 25px 0;
  }
  .back-link {
    margin-bottom: 24px;
  }
  @media (max-width: 600px) {
    .article-header,
    .prose {
      padding: 24px 20px;
    }
    .article-header h1 {
      font-size: 46px;
    }
    .prose {
      font-size: 13px;
    }
    .article-date {
      font-size: 9px;
    }
  }
</style>
