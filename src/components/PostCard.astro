---
import type { IconName } from "./icons";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import PixelIcon from "./PixelIcon.astro";
interface Props {
  post: CollectionEntry<"blog">;
  index?: number;
  variant?: "compact" | "detailed";
  headingLevel?: "h2" | "h3";
}
const {
  post,
  index = 0,
  variant = "compact",
  headingLevel: Heading = "h3",
} = Astro.props;
const icons: IconName[] = ["code", "chip", "disk", "monitor"];
---

<a
  class:list={["post-card", { "post-card--detailed": variant === "detailed" }]}
  href={`/blog/${post.id}/`}
>
  <div class="post-art">
    <PixelIcon name={icons[index % icons.length]} />
    <span class="post-art-label">
      NOTE_{String(index + 1).padStart(2, "0")}.MD
    </span>
  </div>
  <div class="post-copy">
    <FormattedDate date={post.data.pubDate} />
    <Heading class="post-title">{post.data.title}</Heading>
    {variant === "detailed" && <p>{post.data.description}</p>}
    <span class="read-post">
      Read the story <span aria-hidden="true">↗</span>
    </span>
  </div>
</a>

<style>
  .post-card {
    text-decoration: none;
    border: 1px solid var(--line);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.15s,
      box-shadow 0.15s;
  }
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 4px 5px 0 var(--shadow);
  }
  .post-art {
    height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--blue);
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
    background-image: radial-gradient(var(--line) 0.7px, transparent 0.7px);
    background-size: 9px 9px;
  }
  .post-art :global(svg) {
    width: 68px;
    height: 68px;
  }
  .post-art-label {
    position: absolute;
    bottom: 9px;
    left: 12px;
    font-size: 8px;
    background: var(--surface);
    padding: 1px 5px;
  }
  .post-copy {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .post-copy :global(time) {
    font-size: 9px;
    color: var(--muted);
  }
  .post-copy :global(.post-title) {
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: normal;
    font-size: 14px;
    line-height: 1.6;
    margin: 12px 0 18px;
  }
  .post-copy p {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .post-copy .read-post {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    text-transform: uppercase;
    margin-top: auto;
  }
  .post-card--detailed .post-art {
    height: 170px;
  }
  .post-card--detailed .post-copy :global(.post-title) {
    font-size: 18px;
  }
  .post-card--detailed .post-copy {
    padding: 25px;
  }
  @media (max-width: 900px) {
    .post-copy {
      padding: 15px;
    }
  }
  @media (max-width: 600px) {
    .post-art {
      height: 150px;
    }
    .post-copy {
      padding: 22px;
    }
    .post-copy :global(.post-title) {
      font-size: 16px;
    }
  }
</style>
