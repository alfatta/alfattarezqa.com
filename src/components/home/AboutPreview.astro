---
import PixelIcon from "../PixelIcon.astro";
---

<section class="section about-preview" aria-labelledby="approach-title">
  <div>
    <span class="label">The person behind the pixels</span>
    <h2 id="approach-title">
      Modern code.
      <br />A retro soul.
    </h2>
    <p>
      I build interfaces that feel right, APIs that do the heavy lifting, and
      tools that make everyday work a little better.
    </p>
    <a class="text-link" href="/about/">
      More about me <span>→</span>
    </a>
  </div>
  <div class="capabilities">
    <article class="capability">
      <PixelIcon name="monitor" />
      <h3>Frontend first</h3>
      <p>
        Thoughtful interfaces.
        <br />
        Details that matter.
      </p>
    </article>
    <article class="capability">
      <PixelIcon name="chip" />
      <h3>Full-stack kit</h3>
      <p>
        From the browser
        <br />
        to the database.
      </p>
    </article>
    <article class="capability">
      <PixelIcon name="disk" />
      <h3>Always curious</h3>
      <p>
        Build. Learn.
        <br />
        Make it better.
      </p>
    </article>
  </div>
</section>

<style>
  .about-preview {
    display: grid;
    grid-template-columns: 1.1fr 1.9fr;
    gap: 40px;
    align-items: center;
  }
  .about-preview h2 {
    font-size: 42px;
    text-transform: uppercase;
    margin: 15px 0;
  }
  .about-preview p {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .capabilities {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .capability {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 25px 15px;
    text-align: center;
    position: relative;
  }
  .capability::before {
    content: "";
    position: absolute;
    width: 5px;
    height: 5px;
    top: -1px;
    left: -1px;
    background: var(--paper);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .capability :global(svg) {
    width: 54px;
    height: 54px;
    margin: 0 auto 20px;
  }
  .capability h3 {
    text-transform: uppercase;
    font-size: 10px;
    margin-bottom: 12px;
  }
  .capability p {
    font-size: 10px;
    margin: 0;
    line-height: 1.8;
  }
  @media (max-width: 900px) {
    .about-preview {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .about-preview > div:first-child {
      max-width: 550px;
    }
  }
  @media (max-width: 600px) {
    .capabilities {
      gap: 8px;
    }
    .capability {
      padding: 20px 8px;
    }
    .capability p {
      font-size: 9px;
    }
    .capability h3 {
      font-size: 9px;
    }
    .capability :global(svg) {
      width: 43px;
      height: 43px;
    }
  }
</style>
