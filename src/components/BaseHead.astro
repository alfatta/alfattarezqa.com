---
import type { ImageMetadata } from "astro";
import { SITE_TITLE } from "../consts";
import { ABOUT, contacts } from "../data/profile";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  article?: {
    title: string;
    published: Date;
    modified?: Date;
  };
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image = "/og-image.png",
  imageAlt = title,
  article,
} = Astro.props;
const imageURL = new URL(
  typeof image === "string" ? image : image.src,
  Astro.site ?? Astro.url,
);
const siteURL = new URL("/", Astro.site);
const authorURL = new URL("/about/", siteURL);
const authorID = `${authorURL}#person`;
const websiteID = `${siteURL}#website`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": authorID,
      name: ABOUT.name,
      url: authorURL.href,
      jobTitle: ABOUT.jobTitle,
      sameAs: contacts
        .filter((contact) => contact.href.startsWith("https://"))
        .map((contact) => contact.href),
    },
    {
      "@type": "WebSite",
      "@id": websiteID,
      url: siteURL.href,
      name: SITE_TITLE,
      publisher: { "@id": authorID },
      inLanguage: "en",
    },
    {
      "@type": article ? "BlogPosting" : "WebPage",
      "@id": `${canonicalURL}#${article ? "article" : "webpage"}`,
      url: canonicalURL.href,
      name: title,
      description,
      image: imageURL.href,
      inLanguage: "en",
      isPartOf: { "@id": websiteID },
      ...(article && {
        headline: article.title,
        mainEntityOfPage: canonicalURL.href,
        author: {
          "@id": authorID,
          "@type": "Person",
          name: ABOUT.name,
          url: authorURL.href,
        },
        datePublished: article.published.toISOString(),
        dateModified: (article.modified ?? article.published).toISOString(),
      }),
    },
  ],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<script is:inline>
  (() => {
    let theme;
    try {
      theme = localStorage.getItem("theme");
    } catch {}
    document.documentElement.dataset.theme =
      theme === "light" || theme === "dark"
        ? theme
        : window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
  })();
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={ABOUT.name} />
<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
/>
<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
{image === "/og-image.png" && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
{article && (
  <>
    <meta
      property="article:published_time"
      content={article.published.toISOString()}
    />
    <meta
      property="article:modified_time"
      content={(article.modified ?? article.published).toISOString()}
    />
    <meta property="article:author" content={authorURL} />
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />
