---
import PixelIcon from "./PixelIcon.astro";
---

<div class="pixrelay-visual" aria-hidden="true">
  <div class="file-art">
    <PixelIcon name="image" />
    <small>original.png</small>
  </div>
  <span class="relay-arrow">→</span>
  <div class="file-art">
    <PixelIcon name="chip" />
    <small>PIXRELAY</small>
  </div>
  <span class="relay-arrow">→</span>
  <div class="file-art">
    <PixelIcon name="image" />
    <small>just-right.webp</small>
  </div>
</div>

<style>
  .pixrelay-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 2vw, 25px);
    width: 100%;
  }
  .file-art {
    width: 80px;
    min-width: 0;
    flex: 1;
    text-align: center;
  }
  .file-art :global(svg) {
    width: 80px;
    height: 80px;
  }
  .file-art small {
    display: block;
    font-size: 9px;
    margin-top: 5px;
    overflow-wrap: anywhere;
  }
  .relay-arrow {
    font-family: var(--font-display);
    font-size: 30px;
  }
</style>
