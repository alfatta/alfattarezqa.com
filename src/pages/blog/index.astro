---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";
import ContactBanner from "../../components/ContactBanner.astro";
import { SITE_TITLE } from "../../consts";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SiteLayout
  title={`Frontend Development Blog | ${SITE_TITLE}`}
  description="Notes on frontend development, Vue, personal tooling, and things learned along the way."
>
  <main id="main" class="site-width page-main">
    <header class="page-heading">
      <span class="label">Notes from the keyboard</span>
      <h1>Bits & thoughts.</h1>
      <p>
        Things I've built, things I've learned, and ideas worth writing down. A
        little collection of notes from a life in code.
      </p>
    </header>
    <div class="section-title">
      <span class="eyebrow">
        {String(posts.length).padStart(2, "0")} ENTRIES / NEWEST FIRST
      </span>
      <a class="text-link" href="/rss.xml">
        RSS feed ↗
      </a>
    </div>
    <div class="post-grid blog-list">
      {posts.map((post, index) => (
        <PostCard
          post={post}
          index={index}
          variant="detailed"
          headingLevel="h2"
        />
      ))}
    </div>
    <ContactBanner />
  </main>
</SiteLayout>

<style>
  .blog-list {
    grid-template-columns: repeat(2, 1fr);
  }
  @media (max-width: 600px) {
    .blog-list {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
